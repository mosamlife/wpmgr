# WPMgr — self-host environment.
#
# Copy this file to .env and fill in the secrets, then bring up the stack:
#
#   ./scripts/init-env.sh      # copies this file -> .env AND injects fresh secrets
#   # ── or do it by hand ──
#   cp .env.example .env
#   docker compose run --rm api wpmgr-cli gen-secrets   # paste the 4 lines into .env
#
# Variables are grouped:
#   [REQUIRED — ALWAYS]      must be set for ANY boot (dev or prod), or the app exits.
#   [REQUIRED — PRODUCTION]  must be set when WPMGR_ENV=production, or the app exits /
#                            silently disables a feature. Safe defaults exist for dev.
#   [OPTIONAL]               has a working default; set only to override behaviour.
#
# Every WPMGR_* var the app reads is prefixed `WPMGR_`. Values shown after `=` are
# dev defaults / illustrative placeholders — ROTATE every secret before exposing
# the service to a network.


# =============================================================================
# [REQUIRED — ALWAYS]  Set these or the app will not boot.
# =============================================================================

# Session signing secret. Format: opaque random string, >=32 characters; must NOT
# be empty and must NOT start with "change-me". The app hard-fails boot otherwise.
# run: docker compose run --rm api wpmgr-cli gen-secrets   (or: openssl rand -base64 48)
WPMGR_SESSION_SECRET=

# Postgres APP role — the UNPRIVILEGED login the app connects as (NOSUPERUSER
# NOBYPASSRLS; RLS is the real tenant-isolation backstop). The app refuses to boot
# if this role can bypass RLS (see WPMGR_ALLOW_RLS_BYPASS_ROLE).
# Format: role name. e.g. wpmgr_app
WPMGR_DB_USER=wpmgr_app
# Password for WPMGR_DB_USER. Format: string. e.g. a-long-random-password
WPMGR_DB_PASSWORD=wpmgr-app-dev-secret


# =============================================================================
# [REQUIRED — PRODUCTION]  Safe dev defaults below; you MUST change these for a
# real, network-exposed deploy (several hard-fail boot when WPMGR_ENV=production).
# =============================================================================

# Mark the deployment as production: enables JSON logs AND the hard-fail guards
# (rejects the committed dev agent key, requires the age secret below, etc.).
# Format: "production" (or "prod"); anything else = development. e.g. production
WPMGR_ENV=development

# Postgres host/port/name/sslmode. In docker-compose the host is the service name
# "postgres". Format: WPMGR_DB_HOST hostname; PORT integer; SSLMODE one of
# disable|require|verify-ca|verify-full. e.g. postgres / 5432 / wpmgr / disable
WPMGR_DB_HOST=localhost
WPMGR_DB_PORT=5432
WPMGR_DB_NAME=wpmgr
WPMGR_DB_SSLMODE=disable
# Owner/superuser DSN used ONLY to run migrations (CREATE ROLE + privileged DDL).
# Empty => reuse the app DSN (single-DSN dev). Set it in prod to a privileged role;
# when set, a boot-time table-privilege probe also runs.
# Format: full postgres URL.
# e.g. postgres://wpmgr:OWNERPASS@postgres:5432/wpmgr?sslmode=disable
WPMGR_DB_MIGRATION_DSN=

# Redis address (session store + autologin consume store).
# Format: host:port. e.g. redis:6379
WPMGR_REDIS_ADDR=localhost:6379

# Secrets-at-rest key (age X25519). Encrypts stored SMTP passwords, per-site
# email + destination secrets, object-cache creds, and 2FA secrets. OPTIONAL:
# EMPTY => the key is derived from WPMGR_SESSION_SECRET, so it is exactly as
# stable as that secret. On a plain Docker/VM install where .env never changes,
# that means secrets survive restarts. BUT on any platform that regenerates env
# values per deploy (many PaaS do), the derived key ROTATES with each deploy and
# every stored secret becomes undecryptable: two-factor works once then fails on
# every later login, and SMTP/destination credentials are lost until re-entered.
# On such platforms you MUST set an explicit value here AND keep
# WPMGR_SESSION_SECRET fixed. The api logs a key fingerprint at boot and WARNs
# when stored secrets no longer decrypt; that WARN is the tell the key rotated.
# Format: age secret key, the literal "AGE-SECRET-KEY-1..." (UPPERCASE; mixed
# case is rejected).
# run: docker compose run --rm api wpmgr-cli gen-secrets   (or: age-keygen)
# NOTE: switching between derived and explicit (or changing either) re-keys the
# store, so re-enter your SMTP password / secrets once after the change.
WPMGR_SITE_DEST_AGE_SECRET=

# Control-plane Ed25519 agent-signing keypair. Signs CP->agent commands; the public
# half is handed to agents at enrollment to verify commands. EMPTY => CP->agent
# commands, autologin mint, and ADR-042 self-update are DISABLED (warned, not fatal).
# In production the committed DEV key below is REJECTED — generate a fresh pair.
# Format: PRIVATE = base64-std of the raw 64-byte key (seed||pub);
#         PUBLIC  = base64-std of the raw 32-byte key. The two must correspond.
# run: docker compose run --rm api wpmgr-cli gen-secrets   (or: ./scripts/gen-keys.sh)
# !! The values below are a PUBLIC committed DEV pair — DO NOT use in production. !!
WPMGR_AGENT_SIGNING_PRIVATE_KEY=aWuH1W3DSfBwuE/V/H9BEmV9IAJfK5d6F2RDfYSj/raBW+b26qHT3spd1gHSw7aXEXxZkg9E9WMspibSjSFsnQ==
WPMGR_AGENT_SIGNING_PUBLIC_KEY=gVvm9uqh097KXdYB0sO2lxF8WZIPRPVjLKYm0o0hbJ0=

# Public base URL of THIS control plane. ONE origin serves three audiences, so
# it has to satisfy all three: agents reach back to it, every emailed link
# (invite, password reset, email verification) is built from it, and the social
# sign-in redirect_uri is derived from it. Format: absolute URL, no trailing
# slash. Leading/trailing whitespace and a trailing slash are trimmed on load.
#
# Point it at the origin a BROWSER uses, which in this compose stack is the web
# container (nginx, WPMGR_WEB_PORT, default 8088). nginx serves the dashboard
# AND proxies /api/, /auth/, /enroll, /agent/, /rum/ and /webhooks/ to the API,
# so agents reach it there too. The API's own host port (WPMGR_API_PORT,
# default 8081) serves no dashboard: an emailed reset link or a post-sign-in
# redirect built on it lands the person on a 404. (:8080 is the
# container-internal listen address, WPMGR_HTTP_ADDR, and is not published at
# all.) In production this is your public https URL.
# e.g. http://YOUR_SERVER_IP:8088  or  https://wpmgr.example.com
WPMGR_PUBLIC_BASE_URL=http://localhost:8088

# S3-compatible object storage (self-host: SeaweedFS; managed: AWS S3). The agent
# must be able to reach presigned URLs minted from WPMGR_S3_ENDPOINT — the
# in-network default http://seaweedfs:8333 is NOT reachable by an external agent,
# so for any real WP host set it to a publicly reachable hostname (e.g. a tunnel).
# See docs/install.md#s3-networking for the full reverse-proxy recipe and NAT
# hairpinning notes before changing this value in a production deployment.
# Format: WPMGR_S3_ENDPOINT URL; BUCKET name; ACCESS_KEY / SECRET_KEY strings.
# EMPTY bucket => backup/restore return 501 and self-update is disabled (warned).
# e.g. http://seaweedfs:8333 / wpmgr-backups / wpmgr / a-long-random-secret
WPMGR_S3_ENDPOINT=http://localhost:8333
WPMGR_S3_BUCKET=wpmgr-backups
WPMGR_S3_ACCESS_KEY=wpmgr
WPMGR_S3_SECRET_KEY=wpmgr-dev-secret
# AWS region string. Format: region. e.g. us-east-1
WPMGR_S3_REGION=us-east-1
# Path-style addressing — required true for SeaweedFS/MinIO. Format: true|false.
WPMGR_S3_FORCE_PATH_STYLE=true


# =============================================================================
# [OPTIONAL]  Working defaults; set only to override.
# =============================================================================

# ---- Server ----
# API container-internal listen address. The Go binary binds :8080 INSIDE the
# container. The HOST-facing port is WPMGR_API_PORT below (default 8081) — that
# is what you curl / put behind a reverse proxy. Do not confuse the two.
# Format: Go host:port. e.g. :8080
WPMGR_HTTP_ADDR=:8080
# Log level. Format: debug|info|warn|error. e.g. info
WPMGR_LOG_LEVEL=info
# Path to an optional YAML config file (precedence defaults<file<env).
# Format: filesystem path; empty skips file loading. e.g. /etc/wpmgr/config.yaml
WPMGR_CONFIG_FILE=

# ---- docker-compose HOST ports (compose-only; the Go app never reads these) ----
# Which HOST port each container is published on. Only the host side changes —
# container-side ports stay fixed, so in-network wiring (WPMGR_S3_ENDPOINT,
# WPMGR_OIDC_ISSUER, etc.) is unaffected. Defaults deliberately avoid the common
# 80 / 8080 so a first boot never collides with something already listening.
#   dashboard -> http://localhost:8088     api -> http://localhost:8081
# Format: integer host port.
WPMGR_WEB_PORT=8088
WPMGR_API_PORT=8081
WPMGR_S3_PORT=8333
WPMGR_DEX_PORT=5556
# Observability profile only (published with --profile observability):
WPMGR_GRAFANA_PORT=3000
WPMGR_OTLP_GRPC_PORT=4317
WPMGR_OTLP_HTTP_PORT=4318

# ---- Auth / sessions ----
# Dev escape hatch: allow boot even if the DB role can bypass RLS. MUST be false in
# production. Format: true|false.
WPMGR_ALLOW_RLS_BYPASS_ROLE=false
# Redis password (empty = no auth). Format: string.
WPMGR_REDIS_PASSWORD=
# Session lifetimes. Format: Go duration. e.g. 168h (idle), 720h (absolute).
WPMGR_AUTH_IDLE_TIMEOUT=168h
WPMGR_AUTH_ABSOLUTE_EXPIRY=720h
# OIDC relying party (self-host via Dex). Empty issuer => email+password only.
# A non-empty issuer that fails discovery HARD-FAILS boot. Format: URLs / strings.
# NOTE: WPMGR_OIDC_REDIRECT_URL uses the HOST-facing port (WPMGR_API_PORT=8081),
# not the container-internal port (:8080).
WPMGR_OIDC_ISSUER=
WPMGR_OIDC_CLIENT_ID=
WPMGR_OIDC_CLIENT_SECRET=
# The OIDC callback is reached by the browser through the nginx web container
# (WPMGR_WEB_PORT=8088 by default); nginx proxies /auth/* to the api internally.
# Do NOT use port 8081 (direct API host port) or :8080 (container-internal).
WPMGR_OIDC_REDIRECT_URL=http://localhost:8088/auth/oidc/callback
# Social sign-in (Google, GitHub). BOTH the id and the secret of a provider must
# be set or that provider stays off, so a half-entered credential never renders
# a button that fails at the provider. It does NOT stay off quietly: half a
# credential is named in the boot log as a WARNING and printed by
# `wpmgr-cli validate-env`. Leaving all four empty is perfectly legal and is the
# default: it simply means email and password are the only way in.
#
# NOTHING HERE CAN STOP THE CONTROL PLANE FROM STARTING. A mistake in this
# block switches OFF the sign-in method it concerns and leaves backups, updates,
# monitoring and the dashboard running.
#
# Unlike OIDC above, the redirect URI is NOT configured here: it is DERIVED as
#   <WPMGR_PUBLIC_BASE_URL>/auth/social/<provider>/callback
# so it can never point at a host you do not control. That makes
# WPMGR_PUBLIC_BASE_URL required for social sign-in, and it must be an absolute
# http(s) URL: an empty value would derive the relative path
# /auth/social/google/callback, which every provider rejects. When it is not
# usable, social sign-in is switched off (no button) and the reason is logged,
# rather than a button being offered that dead-ends at the provider.
#
# Register that exact URL at the provider. With WPMGR_PUBLIC_BASE_URL as set
# above in this file, the two derived callbacks are exactly:
#   http://localhost:8088/auth/social/google/callback
#   http://localhost:8088/auth/social/github/callback
# Change WPMGR_PUBLIC_BASE_URL and both change with it. Those two lines are not
# hand-maintained prose: a test (TestEnvExampleDocumentsTheDerivedSocialCallback)
# derives them from this file's own WPMGR_PUBLIC_BASE_URL using the same
# function the server uses, so they cannot drift from what the code produces.
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth
# client ID -> Web application. Scopes openid, email, profile are all
# non-sensitive, so no Google verification review is needed.
#
# GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App. It must
# be an OAuth App, NOT a GitHub App: a GitHub App token cannot read
# /user/emails, which is the only source of a verified address, so sign-in would
# fail for everyone. One callback URL is allowed per app, so dev and production
# need separate apps.
#
# A failure to reach Google's discovery endpoint does NOT block boot; it fails
# that one sign-in attempt and retries on the next.
WPMGR_SOCIAL_GOOGLE_CLIENT_ID=
WPMGR_SOCIAL_GOOGLE_CLIENT_SECRET=
WPMGR_SOCIAL_GITHUB_CLIENT_ID=
WPMGR_SOCIAL_GITHUB_CLIENT_SECRET=
# WebAuthn / passkeys (dashboard 2FA). Defaults point at the hosted instance
# (manage.wpmgr.app); self-hosters who want passkeys MUST set both to their own
# dashboard domain. Left commented out so the built-in defaults apply.
# Relying-party ID: the registrable domain the dashboard is served on.
# Format: hostname. e.g. manage.example.com
#WPMGR_AUTH_WEBAUTHN_RPID=manage.example.com
# Allowed origins, comma-separated; must be https:// and match the dashboard
# URL exactly (production boot rejects http:// and localhost origins).
# Format: comma-separated URLs. e.g. https://manage.example.com
#WPMGR_AUTH_WEBAUTHN_RP_ORIGINS=https://manage.example.com
# Human-readable name shown in the browser passkey prompt. Format: string.
# Default: WPMgr.
#WPMGR_AUTH_WEBAUTHN_RP_DISPLAY_NAME=WPMgr

# ---- Agent protocol tuning ----
# Anti-replay signature skew, heartbeat-staleness threshold, health-job cadence.
# Format: Go duration. e.g. 5m / 10m / 5m
WPMGR_AGENT_SIGNATURE_SKEW=5m
WPMGR_AGENT_STALE_AFTER=10m
WPMGR_AGENT_HEALTH_INTERVAL=5m

# ---- Backups (M4) ----
# Presign TTL; retention window; monthly-archive keep; scheduler + GC cadence;
# per-attempt CP->agent backup/restore timeout (must outlast a real-site snapshot).
# Format: durations / integers. e.g. 1h / 30 / 12 / 5m / 1h / 10m
WPMGR_BACKUP_PRESIGN_TTL=1h
WPMGR_BACKUP_RETENTION_DAYS=30
WPMGR_BACKUP_MONTHLY_ARCHIVE_KEEP=12
WPMGR_BACKUP_SCHEDULE_INTERVAL=5m
WPMGR_BACKUP_GC_INTERVAL=1h
WPMGR_BACKUP_HTTP_TIMEOUT=10m

# Two-tier progress watchdog (GH #279): a soft stall only stamps stalled_at
# and keeps the run going (the UI shows a "taking longer than expected"
# hint); only a hard stall actually fails the run. hard must be >= soft.
# Format: Go duration. e.g. 3m / 30m
WPMGR_BACKUP_STALL_SOFT_TIMEOUT=3m
WPMGR_BACKUP_STALL_HARD_TIMEOUT=30m

# ---- Updates (M3) ----
# Per-tenant update parallelism; CP->agent command/probe timeout + retries.
# Format: integer / Go duration / integer. e.g. 5 / 30s / 2
WPMGR_UPDATE_PER_TENANT_PARALLELISM=5
WPMGR_UPDATE_HTTP_TIMEOUT=30s
WPMGR_UPDATE_HTTP_RETRIES=2
# Per-attempt timeout for the actual update/rollback apply dispatch only (a real
# update runs its pre-update snapshot, download, extract, and DB migration inline
# on the agent, so it needs far longer than the snappy probe timeout above).
# Format: Go duration. Default: 5m.
#WPMGR_UPDATE_APPLY_HTTP_TIMEOUT=5m

# ---- Agent release mirror (GH #302) ----
# A self-hosted install has no published agent release: the project's release
# pipeline writes the agent zip + agent-releases/latest.json into the HOSTED
# service's bucket, and nothing ever writes into yours. So the dashboard shows no
# reference version and your sites are never offered an agent upgrade.
#
# Turn this on and the control plane reads the public GitHub release every 6
# hours, verifies it (sha256 + size cross-checked against the GitHub API's own
# per-asset digest, then again against the streamed download), and publishes the
# SAME two objects into YOUR object storage. Everything downstream is unchanged:
# your sites keep talking only to your control plane, and there is nothing to add
# to any site's wp-config.php.
#
# Requires object storage (WPMGR_S3_*) to be configured. Outbound HTTPS to
# api.github.com and github.com is required while it runs; if either is
# unreachable the job simply mirrors nothing that cycle.
# Format: bool / string / string. Default: false / mosamlife / wpmgr.
#WPMGR_UPDATE_AGENT_MIRROR_ENABLED=false
# Point these at a fork to mirror its releases instead of the upstream project's.
#WPMGR_UPDATE_AGENT_MIRROR_OWNER=mosamlife
#WPMGR_UPDATE_AGENT_MIRROR_REPO=wpmgr

# ---- Serve the mirrored agent package FROM the control plane (GH #302) ----
# The second half of the mirror. A mirrored package lives in YOUR object
# storage, and a presigned URL for it points at YOUR storage host, which differs
# per install and can never be an agent default. That is why the documented
# workaround was to add WPMGR_AGENT_PACKAGE_HOST to every site's wp-config.php.
#
# Turn this on and the control plane serves the package itself, from a host every
# one of your sites already trusts: the control plane they are enrolled with. The
# signed manifest's package_url becomes a control-plane URL carrying a
# short-lived token (bound to one site, one version, one expiry, signed with the
# same key that signs the manifest), so there is nothing to configure per site.
#
# ROLLOUT ORDER MATTERS. Only agents new enough to trust their own control-plane
# host accept a control-plane package_url; an older agent refuses it on its host
# allowlist. Turn this on once your sites run an agent that includes GH #302, or
# after upgrading them once by hand.
#
# Requires object storage (WPMGR_S3_*) and WPMGR_AGENT_SIGNING_PRIVATE_KEY.
# Format: bool. Default: false.
#WPMGR_UPDATE_AGENT_PACKAGE_SERVE_ENABLED=false
# Public origin used to build that URL. Leave EMPTY (the default) and it is
# derived from the control-plane URL the agent itself used to fetch the manifest,
# which needs no configuration. Set it only if your control plane sits behind a
# proxy that rewrites Host. Falls back to WPMGR_PUBLIC_BASE_URL when unset.
# Format: absolute https URL, no trailing slash. Default: empty.
#WPMGR_UPDATE_AGENT_PACKAGE_BASE_URL=https://cp.example.com

# ---- ClickHouse (metrics: M5 uptime time-series + analytics) ----
# Empty addr => metrics store disabled (uptime queries return empty; stack still
# runs). Format: WPMGR_CLICKHOUSE_ADDR host:port (NATIVE proto, port 9000);
# DB/USERNAME/PASSWORD strings. e.g. clickhouse:9000 / wpmgr_metrics / default
# NOTE: the app reads WPMGR_CLICKHOUSE_USERNAME; the compose server image is
# configured via CLICKHOUSE_USER (a different var) — keep them in sync.
WPMGR_CLICKHOUSE_ADDR=clickhouse:9000
WPMGR_CLICKHOUSE_DB=wpmgr_metrics
WPMGR_CLICKHOUSE_USERNAME=default
WPMGR_CLICKHOUSE_PASSWORD=

# ---- Uptime monitoring (M5) ----
# Probe interval/timeout/concurrency; alert interval; consecutive-down threshold.
# Format: durations / integers. e.g. 60s / 15s / 10 / 60s / 2
WPMGR_UPTIME_PROBE_INTERVAL=60s
WPMGR_UPTIME_PROBE_TIMEOUT=15s
WPMGR_UPTIME_PROBE_CONCURRENCY=10
WPMGR_UPTIME_ALERT_INTERVAL=60s
WPMGR_UPTIME_DOWN_THRESHOLD=2
# Fleet size the probe sweep's River job Timeout() budget is sized against
# (see uptime.DeriveProbeJobTimeout), deliberately NOT a live enrolled-site
# count, which would go stale as the fleet grows. Raise only if a single
# deployment's enrolled site count genuinely approaches this ceiling; a
# larger fleet is not silently broken by leaving it as-is (the sweep degrades
# to a partial-but-recorded result instead). Format: integer. Default 2000.
#WPMGR_UPTIME_MAX_FLEET_SIZE=2000
# WSOD detection kill-switch: an HTTP-200 response whose body is really a WP
# fatal-error page is classified DOWN. On by default; ONLY "0" or "false"
# (case-insensitive) disables it. Format: true|false.
#WPMGR_UPTIME_WPFATAL_DETECT=true
# Cron-kick pass: the CP periodically GETs each enrolled site's wp-cron.php so
# fully page-cached sites still boot PHP and drain WP-Cron with zero organic
# PHP traffic. ENABLED true|false (default true); INTERVAL/TIMEOUT Go durations
# (defaults 5m / 5s); CONCURRENCY integer (default 10).
#WPMGR_CRON_KICK_ENABLED=true
#WPMGR_CRON_KICK_INTERVAL=5m
#WPMGR_CRON_KICK_TIMEOUT=5s
#WPMGR_CRON_KICK_CONCURRENCY=10

# ---- Connection lifecycle sweeper (M21) ----
# How long a connected site's heartbeat may be stale before it counts as overdue
# (default 300s); consecutive overdue evaluations before it is marked degraded
# (default 3); hard staleness cutoff before a degraded site is marked
# disconnected (default 900s). Format: Go durations / integer.
#WPMGR_CONN_DEGRADE_AFTER=300s
#WPMGR_CONN_DEGRADE_MISS_THRESHOLD=3
#WPMGR_CONN_DISCONNECT_AFTER=900s
# Active liveness verify: before degrading or disconnecting, the sweeper dials
# the agent; a successful response resets the miss counter and skips the
# transition. ACTIVE_VERIFY true|false (default true); per-dial TIMEOUT Go
# duration (default 8s); max concurrent dials per sweep (default 8).
#WPMGR_SWEEP_ACTIVE_VERIFY=true
#WPMGR_SWEEP_VERIFY_TIMEOUT=8s
#WPMGR_SWEEP_VERIFY_CONCURRENCY=8

# ---- Alert SMTP (M5 downtime alerts; M7 reports) ----
# The ops ALERT engine. Empty host => email alerts no-op (webhooks still fire).
# This is also the bootstrap fallback for transactional mail (the DB smtp_settings
# row, set in the dashboard, takes precedence). Any SMTP provider works.
# Format: HOST hostname; PORT integer; TLS_MODE starttls|tls|none; others strings.
WPMGR_SMTP_HOST=
WPMGR_SMTP_PORT=587
WPMGR_SMTP_USERNAME=
WPMGR_SMTP_PASSWORD=
WPMGR_SMTP_FROM=alerts@wpmgr.local
WPMGR_SMTP_TLS_MODE=starttls
# From/support address for transactional mail. Format: email. Default support@wpmgr.app.
WPMGR_SUPPORT_EMAIL=

# ---- One-Click Login (Phase 5.5) ----
# Feature flag for 2FA step-up on per-site autologin policies (no-op until TOTP
# ships). Format: true|false.
WPMGR_AUTOLOGIN_REQUIRE_2FA_STEP_UP=false

# ---- Media Optimizer (ADR-043, part of the base Compose stack) ----
# URL of the media-encoder service for the scale-to-zero waker; empty disables the
# wake POST. Format: URL. e.g. http://media-encoder:8080
WPMGR_MEDIA_ENCODER_URL=
# Bounded encode concurrency — read ONLY by the media-encoder binary, not the api.
# Format: integer. e.g. 2
WPMGR_MEDIA_ENCODE_WORKERS=2
# River schema for encoder-owned media and screenshot jobs. REQUIRED to be a
# dedicated schema (never the api's default/public schema) whenever a
# media-encoder process runs: River leader election is per-schema, and a
# media-encoder sharing the api's schema can silently win leadership and stop
# ALL fleet periodic jobs (backups, uptime checks, sweeps) with no error (GH
# #205). The media-encoder binary now refuses to start on the default/public
# schema. Set the SAME value on both the api and media-encoder processes.
# Format: simple Postgres identifier. e.g. media_encoder
WPMGR_RIVER_MEDIA_SCHEMA=media_encoder
# Screenshot ready-wait budget in WHOLE SECONDS (read by the media-encoder
# binary): total time a capture may wait for page load + network idle + render
# settle before shooting. Raise on especially slow hosting. Default 8; values
# above the capture deadline are clamped. Format: integer seconds.
#WPMGR_SCREENSHOT_READY_WAIT=8
# Chromium binary path used for screenshots (read by the media-encoder binary).
# Set only if your Chromium lives somewhere else. Format: filesystem path.
# Default /usr/bin/chromium-browser (baked into the encoder image).
#WPMGR_CHROMIUM_BIN=/usr/bin/chromium-browser

# ---- Telemetry ----
# Empty => OTLP export disabled (traces stay in-process). Format: collector URL.
# e.g. http://otel-lgtm:4318
WPMGR_OTEL_EXPORTER_OTLP_ENDPOINT=
# OTel service name. Format: string. e.g. wpmgr-api
WPMGR_OTEL_SERVICE_NAME=wpmgr-api

# ---- Vulnerability scanner ----
# Wordfence Intelligence API key used by the vulnerability-feed refresh when no
# key has been saved in the superadmin UI (the UI-saved key, stored encrypted,
# takes precedence). Empty in both places => the feed refresh no-ops.
# Format: string.
#WPMGR_WORDFENCE_API_KEY=

# ---- Organization deletion ----
# Grace window, in days, that a soft-deleted organization is kept before the
# purge worker PERMANENTLY deletes its rows and object storage. A non-positive
# or non-integer value is rejected with a warning and the default is used.
# Format: positive integer. Default 7.
#WPMGR_ORG_PURGE_GRACE_DAYS=7

# ---- One-shot operations (run once, then UNSET) ----
# Each is read at boot, performs its action, and should be removed afterwards.
# WPMGR_SUPERADMIN_EMAILS        — comma-separated emails; grants is_superadmin
#                                  (seeds a new account + set-password link if absent).
# WPMGR_SUPERADMIN_REVOKE_EMAILS - comma-separated emails; revokes is_superadmin
#                                  (the ONLY supported revoke path; not API-settable).
# WPMGR_SUPERADMIN_RESET_EMAILS  — comma-separated emails; mints a reset link each.
# WPMGR_RECOVER_ACCOUNTS         — "email:org[,email2:org2]"; create user + reset link.
# WPMGR_GRANT_MEMBERSHIPS        — "email:org[,...]"; reconcile membership (no create).
# WPMGR_REVOKE_MEMBERSHIPS       — "email:org[,...]"; revoke membership.
WPMGR_SUPERADMIN_EMAILS=
WPMGR_SUPERADMIN_REVOKE_EMAILS=
WPMGR_SUPERADMIN_RESET_EMAILS=
WPMGR_RECOVER_ACCOUNTS=
WPMGR_GRANT_MEMBERSHIPS=
WPMGR_REVOKE_MEMBERSHIPS=


# =============================================================================
# [HOSTED ONLY]  Managed-SaaS billing and entitlements. Hosted only, leave
# unset on self-host. Self-host installs are unlimited with all of these unset.
# =============================================================================

# Master switch for hosted entitlements (plan/site caps + payment providers).
# Hosted only, leave unset on self-host. Format: true|false. Default false.
#WPMGR_HOSTED=false

# Stripe adapter. ALL FIVE are required TOGETHER once any one is set (boot
# refuses a partially configured provider). The three prices are recurring
# Stripe Price ids created once in the Stripe Dashboard/API.
# Hosted only, leave unset on self-host.
#WPMGR_BILLING_STRIPE_SECRET_KEY=
#WPMGR_BILLING_STRIPE_WEBHOOK_SECRET=
#WPMGR_BILLING_STRIPE_PRICE_STARTER=
#WPMGR_BILLING_STRIPE_PRICE_AGENCY=
#WPMGR_BILLING_STRIPE_PRICE_SCALE=

# Razorpay adapter. ALL NINE are required TOGETHER once any one is set (boot
# refuses a partially configured provider). One recurring Razorpay Plan id per
# currency per tier, created once in the Razorpay Dashboard/API; the webhook
# secret is DISTINCT from the key secret.
# Hosted only, leave unset on self-host.
#WPMGR_BILLING_RAZORPAY_KEY_ID=
#WPMGR_BILLING_RAZORPAY_KEY_SECRET=
#WPMGR_BILLING_RAZORPAY_WEBHOOK_SECRET=
#WPMGR_BILLING_RAZORPAY_PLAN_STARTER_USD=
#WPMGR_BILLING_RAZORPAY_PLAN_STARTER_INR=
#WPMGR_BILLING_RAZORPAY_PLAN_AGENCY_USD=
#WPMGR_BILLING_RAZORPAY_PLAN_AGENCY_INR=
#WPMGR_BILLING_RAZORPAY_PLAN_SCALE_USD=
#WPMGR_BILLING_RAZORPAY_PLAN_SCALE_INR=


# =============================================================================
# [DOCKER-COMPOSE ONLY]  Read by the compose files / postgres init script — the
# Go app NEVER reads these. They provision the Postgres OWNER + app login roles.
# =============================================================================

# Privileged OWNER role the postgres image creates (POSTGRES_USER/PASSWORD).
# The compose migration DSN is built from these; the owner password MUST equal
# POSTGRES_PASSWORD. Format: role name / string.
WPMGR_DB_OWNER_USER=wpmgr
WPMGR_DB_OWNER_PASSWORD=wpmgr
# Password the postgres init script sets on the wpmgr_app LOGIN role. Keep equal
# to WPMGR_DB_PASSWORD above. Format: string.
WPMGR_DB_APP_PASSWORD=wpmgr-app-dev-secret


# =============================================================================
# [FRONTEND]  Baked into the web SPA at build time (Vite).
# =============================================================================
# API base URL the dashboard calls. For the prebuilt GHCR web image this is
# baked in at build time and the dashboard SPA proxies via nginx — you do NOT
# need to set this for the prod-images path. For local source builds override
# to your host-facing URL (WPMGR_API_PORT=8081, NOT :8080 which is container-
# internal). Format: URL. e.g. http://localhost:8081
VITE_API_BASE_URL=http://localhost:8081
